# Model server for Rocky. Install on the UNO Q at
# /etc/systemd/system/rocky-ollama.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now rocky-ollama
#
# Replaces holding a terminal open on start-model.sh. Rocky is a desk device
# that must come back on its own after a power cycle.
[Unit]
Description=Ollama model server for Rocky
After=network.target

[Service]
Type=exec
User=arduino
Group=arduino
# Loopback only: nothing on the Wi-Fi network can reach the model server.
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_CONTEXT_LENGTH=2048
ExecStart=/home/arduino/rocky-runtime/bin/ollama serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
